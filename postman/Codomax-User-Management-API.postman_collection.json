{
  "info": {"name": "Codomax User Management API", "description": "CRUD requests for the Spring Boot User Management API.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}, {"key": "userId", "value": "1"}],
  "item": [
    {"name": "Create user", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"phone\": \"9876543210\",\n  \"age\": 22\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/api/users"}},
    {"name": "Get all users", "request": {"method": "GET", "url": "{{baseUrl}}/api/users"}},
    {"name": "Get user by ID", "request": {"method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}"}},
    {"name": "Update user", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma Updated\",\n  \"email\": \"aarav@example.com\",\n  \"phone\": \"9123456780\",\n  \"age\": 23\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/api/users/{{userId}}"}},
    {"name": "Delete user", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}"}}
  ]
}
